# Jetson Docker light preset
# Purpose: repeatable real-time baseline on Jetson.

JETSON_CAMERA_COLOR_PROFILE=424x240x15
JETSON_CAMERA_DEPTH_PROFILE=424x240x15
JETSON_CAMERA_ENABLE_GYRO=false
JETSON_CAMERA_ENABLE_ACCEL=false
JETSON_CAMERA_EXTRA_ARGS=

JETSON_RTABMAP_DETECTION_RATE=2
JETSON_RTABMAP_ODOM_PROFILE=relaxed
JETSON_RTABMAP_QUEUE_SIZE=15
JETSON_RTABMAP_ENABLE_VIZ=false
JETSON_RTABMAP_WAIT_IMU_TO_INIT=false
JETSON_RTABMAP_IMU_TOPIC=
JETSON_RTABMAP_APPROX_SYNC_MAX_INTERVAL=0.05
JETSON_RTABMAP_EXTRA_ARGS=

JETSON_BENCHMARK_DURATION=20
