<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="trashbot">
  <!--
    Draft robot model for Sprint 3 robot-modeling tasks.
    Replace these dimensions with measured values after the chassis is fixed.
  -->
  <xacro:property name="pi" value="3.141592653589793"/>

  <xacro:property name="base_length" value="0.58"/>
  <xacro:property name="base_width" value="0.42"/>
  <xacro:property name="base_height" value="0.16"/>
  <xacro:property name="base_mass" value="12.0"/>

  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_track" value="0.36"/>
  <xacro:property name="wheel_x" value="0.0"/>
  <xacro:property name="wheel_mass" value="0.6"/>

  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_x" value="0.22"/>

  <!-- Sensor offsets from base_link. These are placeholders until measured. -->
  <xacro:property name="camera_x" value="0.24"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.24"/>
  <xacro:property name="camera_roll" value="0.0"/>
  <xacro:property name="camera_pitch" value="0.0"/>
  <xacro:property name="camera_yaw" value="0.0"/>

  <xacro:property name="imu_x" value="0.18"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.18"/>
  <xacro:property name="imu_roll" value="0.0"/>
  <xacro:property name="imu_pitch" value="0.0"/>
  <xacro:property name="imu_yaw" value="0.0"/>

  <xacro:property name="gps_x" value="-0.18"/>
  <xacro:property name="gps_y" value="0.0"/>
  <xacro:property name="gps_z" value="0.32"/>

  <material name="trashbot_blue">
    <color rgba="0.1 0.35 0.8 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="wheel_gray">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="imu_green">
    <color rgba="0.0 0.65 0.25 1.0"/>
  </material>
  <material name="gps_yellow">
    <color rgba="0.95 0.75 0.1 1.0"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * radius * radius / 2.0}"
        iyz="0.0"
        izz="${mass * (3.0 * radius * radius + length * length) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="trashbot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_x} ${wheel_track / 2.0} ${-base_height / 2.0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_x} ${-wheel_track / 2.0} ${-base_height / 2.0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="wheel_gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.2" x="${caster_radius}" y="${caster_radius}" z="${caster_radius}"/>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="${caster_x} 0 ${-base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.08" x="0.09" y="0.025" z="0.025"/>
  </link>

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
  </joint>

  <!-- D435i optical frame convention: z forward, x right, y down. -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_link_to_color_optical_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_link_to_depth_optical_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.035 0.035 0.008"/>
      </geometry>
      <material name="imu_green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.035 0.035 0.008"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.01" x="0.035" y="0.035" z="0.008"/>
  </link>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.015"/>
      </geometry>
      <material name="gps_yellow"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.015"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.04" radius="0.035" length="0.015"/>
  </link>

  <joint name="base_to_gps" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="${gps_x} ${gps_y} ${gps_z}" rpy="0 0 0"/>
  </joint>
</robot>
