<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="turtle_big">
  <xacro:property name="mesh_file" value="package://trashbot_description/meshes/turtle_big_visual_mesh.stl"/>

  <!-- Tunable sensor offsets (meters, radians) -->
  <xacro:property name="camera_xyz" value="0 0 0"/>
  <xacro:property name="camera_rpy" value="0 0 0"/>
  <xacro:property name="imu_xyz" value="0 0 0"/>
  <xacro:property name="imu_rpy" value="0 0 0"/>
  <xacro:property name="gps_xyz" value="0 0 0"/>
  <xacro:property name="gps_rpy" value="0 0 0"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_file}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="camera_link"/>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
  </joint>

  <link name="gps_link"/>
  <joint name="base_to_gps" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="${gps_xyz}" rpy="${gps_rpy}"/>
  </joint>
</robot>
