        <visual name="blue_panel">
          <pose>5.3 -2.1 0.70 0 0 0</pose>
          <geometry><box><size>0.20 0.85 1.40</size></box></geometry>
          <material><ambient>0.06 0.16 0.72 1</ambient><diffuse>0.06 0.16 0.72 1</diffuse></material>
