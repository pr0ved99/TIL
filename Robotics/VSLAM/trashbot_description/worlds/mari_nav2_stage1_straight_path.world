<?xml version="1.0"?>
<sdf version="1.6">
  <world name="mari_nav2_stage1_straight_path">
    <gravity>0 0 -9.80665</gravity>

    <spherical_coordinates>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.60 0.61 0.58 1</ambient>
      <background>0.68 0.80 0.98 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0.2 0.2 0.18 1</specular>
      <direction>-0.25 0.20 -0.94</direction>
    </light>

    <model name="stage1_ground">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>13 8</size></plane></geometry>
        </collision>
        <visual name="grass_visual">
          <geometry><plane><normal>0 0 1</normal><size>13 8</size></plane></geometry>
          <material><ambient>0.23 0.42 0.24 1</ambient><diffuse>0.23 0.42 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage1_path">
      <static>true</static>
      <link name="link">
        <visual name="straight_walkway">
          <pose>3.8 0 0.010 0 0 0</pose>
          <geometry><box><size>7.2 1.05 0.018</size></box></geometry>
          <material><ambient>0.66 0.62 0.50 1</ambient><diffuse>0.66 0.62 0.50 1</diffuse></material>
        </visual>
        <visual name="start_pad">
          <pose>0.55 0 0.016 0 0 0</pose>
          <geometry><box><size>0.9 1.25 0.025</size></box></geometry>
          <material><ambient>0.58 0.58 0.55 1</ambient><diffuse>0.58 0.58 0.55 1</diffuse></material>
        </visual>
        <visual name="goal_band">
          <pose>7.0 0 0.020 0 0 0</pose>
          <geometry><box><size>0.16 1.05 0.022</size></box></geometry>
          <material><ambient>0.25 0.70 0.30 1</ambient><diffuse>0.25 0.70 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage1_side_boundaries">
      <static>true</static>
      <link name="link">
        <collision name="left_rail_collision">
          <pose>3.8 0.82 0.12 0 0 0</pose>
          <geometry><box><size>7.4 0.08 0.24</size></box></geometry>
        </collision>
        <visual name="left_rail_visual">
          <pose>3.8 0.82 0.12 0 0 0</pose>
          <geometry><box><size>7.4 0.08 0.24</size></box></geometry>
          <material><ambient>0.78 0.76 0.65 1</ambient><diffuse>0.78 0.76 0.65 1</diffuse></material>
        </visual>
        <collision name="right_rail_collision">
          <pose>3.8 -0.82 0.12 0 0 0</pose>
          <geometry><box><size>7.4 0.08 0.24</size></box></geometry>
        </collision>
        <visual name="right_rail_visual">
          <pose>3.8 -0.82 0.12 0 0 0</pose>
          <geometry><box><size>7.4 0.08 0.24</size></box></geometry>
          <material><ambient>0.78 0.76 0.65 1</ambient><diffuse>0.78 0.76 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage1_landmarks">
