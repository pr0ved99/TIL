      <link name="link">
        <visual name="red_panel">
          <pose>4.2 2.2 0.70 0 0 0</pose>
          <geometry><box><size>0.20 0.85 1.40</size></box></geometry>
          <material><ambient>0.75 0.08 0.06 1</ambient><diffuse>0.75 0.08 0.06 1</diffuse></material>
