<?xml version="1.0"?>
<sdf version="1.6">
  <world name="mari_camera_test">
    <gravity>0 0 -9.80665</gravity>

    <spherical_coordinates>
      <!-- Keep GPS local ENU behavior aligned with gazebo_ros_gps_sensor demo. -->
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.80 1.00 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.20 -0.87</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.38 0.40 0.42 1</ambient>
            <diffuse>0.38 0.40 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="floor_reference_tiles">
      <static>true</static>
      <link name="link">
        <visual name="tile_1m">
          <pose>1.0 0 0.003 0 0 0</pose>
          <geometry>
            <box>
              <size>0.50 0.50 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.80 0.80 0.80 1</diffuse>
          </material>
        </visual>
        <visual name="tile_2m_left">
          <pose>2.0 0.45 0.003 0 0 0</pose>
          <geometry>
            <box>
              <size>0.50 0.50 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.16 0.35 0.85 1</ambient>
            <diffuse>0.16 0.35 0.85 1</diffuse>
          </material>
        </visual>
        <visual name="tile_2m_right">
          <pose>2.0 -0.45 0.003 0 0 0</pose>
          <geometry>
            <box>
              <size>0.50 0.50 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.90 0.70 0.15 1</ambient>
            <diffuse>0.90 0.70 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_color_wall">
      <static>true</static>
      <pose>2.7 0 0 0 0 0</pose>
      <link name="link">
        <collision name="wall_collision">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry>
            <box>
              <size>0.08 1.80 1.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="red_left_panel">
          <pose>0 0.60 0.55 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.55 1.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.10 0.08 1</ambient>
            <diffuse>0.85 0.10 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="green_center_panel">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.55 1.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.70 0.18 1</ambient>
            <diffuse>0.08 0.70 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="blue_right_panel">
          <pose>0 -0.60 0.55 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.55 1.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.22 0.85 1</ambient>
            <diffuse>0.08 0.22 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="near_depth_targets">
      <static>true</static>
      <link name="link">
        <collision name="left_box_collision">
          <pose>1.25 0.45 0.18 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.28 0.36</size>
            </box>
          </geometry>
        </collision>
        <visual name="left_box_visual">
          <pose>1.25 0.45 0.18 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.28 0.36</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.55 0.05 1</ambient>
            <diffuse>0.95 0.55 0.05 1</diffuse>
          </material>
        </visual>
        <collision name="right_box_collision">
          <pose>1.80 -0.45 0.28 0 0 0</pose>
          <geometry>
            <box>
              <size>0.36 0.26 0.56</size>
            </box>
          </geometry>
        </collision>
        <visual name="right_box_visual">
          <pose>1.80 -0.45 0.28 0 0 0</pose>
          <geometry>
            <box>
              <size>0.36 0.26 0.56</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.10 0.80 1</ambient>
            <diffuse>0.55 0.10 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="side_landmarks">
      <static>true</static>
      <link name="link">
        <collision name="left_pillar_collision">
          <pose>1.75 0.95 0.45 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.90</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="left_pillar_visual">
          <pose>1.75 0.95 0.45 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.90</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.85 0.85 1</ambient>
            <diffuse>0.15 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="right_pillar_collision">
          <pose>2.15 -0.95 0.35 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="right_pillar_visual">
          <pose>2.15 -0.95 0.35 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.70</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.10 1</ambient>
            <diffuse>0.92 0.92 0.10 1</diffuse>
