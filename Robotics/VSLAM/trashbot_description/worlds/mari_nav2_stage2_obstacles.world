<?xml version="1.0"?>
<sdf version="1.6">
  <world name="mari_nav2_stage2_obstacles">
    <gravity>0 0 -9.80665</gravity>

    <spherical_coordinates>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.60 0.61 0.58 1</ambient>
      <background>0.68 0.80 0.98 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0.2 0.2 0.18 1</specular>
      <direction>-0.25 0.20 -0.94</direction>
    </light>

    <model name="stage2_ground">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>13 9</size></plane></geometry>
        </collision>
        <visual name="grass_visual">
          <geometry><plane><normal>0 0 1</normal><size>13 9</size></plane></geometry>
          <material><ambient>0.23 0.42 0.24 1</ambient><diffuse>0.23 0.42 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage2_path">
      <static>true</static>
      <link name="link">
        <visual name="wide_path">
          <pose>4.0 0 0.010 0 0 0</pose>
          <geometry><box><size>7.6 2.0 0.018</size></box></geometry>
          <material><ambient>0.66 0.62 0.50 1</ambient><diffuse>0.66 0.62 0.50 1</diffuse></material>
        </visual>
        <visual name="start_pad">
          <pose>0.6 0 0.018 0 0 0</pose>
          <geometry><box><size>0.9 1.25 0.025</size></box></geometry>
          <material><ambient>0.58 0.58 0.55 1</ambient><diffuse>0.58 0.58 0.55 1</diffuse></material>
        </visual>
        <visual name="goal_band">
          <pose>7.2 0 0.020 0 0 0</pose>
          <geometry><box><size>0.16 1.4 0.022</size></box></geometry>
          <material><ambient>0.25 0.70 0.30 1</ambient><diffuse>0.25 0.70 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage2_obstacle_box_left">
      <static>true</static>
      <pose>2.7 0.52 0.22 0 0 0.05</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.55 0.50 0.44</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.50 0.44</size></box></geometry>
          <material><ambient>0.78 0.47 0.08 1</ambient><diffuse>0.78 0.47 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage2_obstacle_cylinder_right">
      <static>true</static>
      <pose>4.2 -0.60 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.24</radius><length>0.70</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.24</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.15 0.65 0.72 1</ambient><diffuse>0.15 0.65 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage2_obstacle_box_far">
      <static>true</static>
      <pose>5.6 0.55 0.30 0 0 -0.15</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.50 0.45 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.45 0.60</size></box></geometry>
          <material><ambient>0.55 0.12 0.70 1</ambient><diffuse>0.55 0.12 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stage2_side_landmarks">
      <static>true</static>
      <link name="link">
